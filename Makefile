# Quality gates. The target names are the contract with CI (harness/quality-gates.md).
# test, typecheck, lint and e2e run both projects. sast, deps, drift, check, setup and help come
# from harness/gates.mk. e2e starts backend and frontend itself (Playwright webServer) under
# harness/scripts/app-lock.sh, so only one worktree runs the application at a time.
# backend, frontend and frontend-react read .env in their own subshell; no other target loads it.
# frontend and frontend-react pass only the ports to their process, never the GitLab token.
# e2e runs the suite against the Angular frontend, then the tests tagged @react against the React
# frontend (frontend/playwright.config.ts, E2E_FRONTEND).

include harness/gates.mk

# The backend needs JDK 25. When JAVA_HOME is not set, take the JDK of macOS with this major version.
JAVA_VERSION_WANTED ?= 25
ifeq ($(origin JAVA_HOME), undefined)
JAVA_FOUND := $(shell /usr/libexec/java_home -v $(JAVA_VERSION_WANTED) 2>/dev/null)
ifneq ($(JAVA_FOUND),)
ifeq ($(shell grep -q '^JAVA_VERSION="$(JAVA_VERSION_WANTED)[."]' "$(JAVA_FOUND)/release" 2>/dev/null && echo yes),yes)
export JAVA_HOME := $(JAVA_FOUND)
endif
endif
endif

MVN = cd backend && ./mvnw -q -B
WIREMOCK_VERSION = 3.13.1
PNPM = pnpm -C frontend -s
PNPM_REACT = pnpm -C frontend-react -s
E2E_OWNER ?= $(or $(shell git branch --show-current 2>/dev/null),make-e2e)

.PHONY: test test-backend test-frontend test-frontend-react
.PHONY: typecheck typecheck-backend typecheck-frontend typecheck-frontend-react
.PHONY: lint lint-backend lint-frontend lint-frontend-react format e2e install contracts
.PHONY: gitlab-double backend frontend frontend-react java-version

OPENAPI_HEADER = \# Generated by make contracts from backend/src/main (quarkus-smallrye-openapi). Do not edit.
SCHEMA_HEADER = // Generated by make contracts from contracts/api/openapi.yaml (openapi-typescript). Do not edit.

test: test-backend test-frontend test-frontend-react ## Unit and integration tests of both projects

test-backend: ## Backend tests (JUnit, REST Assured, free port)
	$(MVN) test

test-frontend: ## Frontend unit tests (vitest, once)
	$(PNPM) test

test-frontend-react: ## React frontend unit tests (vitest, once)
	$(PNPM_REACT) test

typecheck: typecheck-backend typecheck-frontend typecheck-frontend-react ## Static type check of both projects

typecheck-backend: ## Compile main and test sources
	$(MVN) -DskipTests compile test-compile

typecheck-frontend: ## Angular build with strict templates
	$(PNPM) typecheck

typecheck-frontend-react: ## tsc with strict and the Vite production build
	$(PNPM_REACT) typecheck

lint: lint-backend lint-frontend lint-frontend-react ## Style and static rules of both projects

lint-backend: ## Spotless check (palantir-java-format)
	$(MVN) spotless:check

lint-frontend: ## angular-eslint and Prettier check
	$(PNPM) lint

lint-frontend-react: ## ESLint (react-hooks, jsx-a11y, text in JSX) and Prettier check
	$(PNPM_REACT) lint

format: ## Apply the formatters of both projects
	$(MVN) spotless:apply
	$(PNPM) format
	$(PNPM_REACT) format

java-version: ## Print the Java version that the backend targets use
	@if [ -n "$$JAVA_HOME" ]; then "$$JAVA_HOME/bin/java" -version; else java -version; fi

backend: ## Start the backend in dev mode on BACKEND_PORT from .env (default 8080)
	@set -a; [ -f .env ] && . ./.env; set +a; cd backend && exec ./mvnw quarkus:dev -Dquarkus.http.port=$${BACKEND_PORT:-8080}

frontend: ## Start the frontend on FRONTEND_PORT from .env (default 4200), proxy to BACKEND_PORT
	@[ -f .env ] && . ./.env; BACKEND_PORT=$${BACKEND_PORT:-8080} exec pnpm -C frontend start --port $${FRONTEND_PORT:-4200}

frontend-react: ## Start the React frontend on FRONTEND_REACT_PORT from .env (default 4300), proxy to BACKEND_PORT
	@[ -f .env ] && . ./.env; BACKEND_PORT=$${BACKEND_PORT:-8080} exec pnpm -C frontend-react start --port $${FRONTEND_REACT_PORT:-4300} --strictPort

e2e: gitlab-double ## End-to-end tests under the application lock: the suite against the Angular frontend, then the tests tagged @react against the React frontend
	@harness/scripts/app-lock.sh acquire --owner "$(E2E_OWNER)" --wait 900
	@status=0; $(PNPM) e2e || status=$$?; \
	  if [ $$status -eq 0 ]; then E2E_FRONTEND=react $(PNPM) e2e || status=$$?; fi; \
	  harness/scripts/app-lock.sh release --owner "$(E2E_OWNER)"; exit $$status

contracts: ## Regenerate contracts/api/openapi.yaml and the schema.d.ts of both frontends from the backend DTOs
	$(MVN) -DskipTests package
	{ echo '$(OPENAPI_HEADER)'; cat backend/target/openapi/openapi.yaml; } > contracts/api/openapi.yaml
	{ echo '$(SCHEMA_HEADER)'; $(PNPM) exec openapi-typescript ../contracts/api/openapi.yaml; } > frontend/src/app/api/schema.d.ts
	cp frontend/src/app/api/schema.d.ts frontend-react/src/api/schema.d.ts

install: ## Install the dependencies of both projects and the Playwright browser
	$(PNPM) install --frozen-lockfile
	$(PNPM) exec playwright install chromium
	$(PNPM_REACT) install --frozen-lockfile
	$(MVN) quarkus:go-offline
	$(MAKE) gitlab-double

gitlab-double: ## Fetch WireMock Standalone for the GitLab double of the end-to-end tests
	$(MVN) dependency:copy -Dartifact=org.wiremock:wiremock-standalone:$(WIREMOCK_VERSION) -DoutputDirectory=target/gitlab-double -Dmdep.stripVersion=true
