# Umgebung des Backends. Kopieren nach .env und GITLAB_TOKEN eintragen (README, Schnellstart).
# Quarkus liest jeden Schlüssel aus der Tabelle im README-Abschnitt GitLab auch als
# Umgebungsvariable: Großbuchstaben, "." und "-" werden zu "_".
# make backend und make frontend lesen die Datei als Shell-Skript: Werte mit Leerzeichen, $ oder ;
# in einfache Anführungszeichen setzen.

# Pflicht: klassischer Personal Access Token oder Project Access Token mit Scope api und
# mindestens der Rolle Developer im Projekt. Ein fine-grained Token ohne Projektrechte bekommt 403.
GITLAB_TOKEN=

# Zahlenwerte zusätzlich als weight am Issue setzen.
# Nur GitLab Premium oder Ultimate, Token mit Rolle Developer; auf false setzen, wenn weight
# nicht verfügbar ist.
PLANNINGPOKER_GITLAB_WRITE_WEIGHT=true

# Optional. Jede Zeile zeigt den Standardwert; zum Ändern das # entfernen.

# Basis-URL der GitLab-Instanz.
# PLANNINGPOKER_GITLAB_BASE_URL=https://gitlab.com

# Verbindungs- und Lesezeit je GitLab-Aufruf.
# PLANNINGPOKER_GITLAB_TIMEOUT=10s

# Verfall inaktiver Sitzungen.
# PLANNINGPOKER_SESSION_TTL=12h

# Obergrenze lebender Sitzungen der Instanz; abgelaufene Sitzungen zählen nicht.
# PLANNINGPOKER_SESSION_MAX_SESSIONS=1000

# Obergrenze der Teilnehmer je Sitzung, der Scrum Master zählt mit.
# PLANNINGPOKER_SESSION_MAX_PARTICIPANTS=50

# Projekt-Allowlist: kommagetrennte Projekt-IDs oder -Pfade. Standard: keiner, alle Projekte
# erlaubt; ein leerer Wert gilt als nicht gesetzt.
# PLANNINGPOKER_SESSION_ALLOWED_PROJECTS=

# Zeit bis zur ersten Nachricht auth einer WebSocket-Verbindung.
# PLANNINGPOKER_REALTIME_AUTH_TIMEOUT=5s

# Ports von Backend und Frontend. make backend und make frontend lesen beide; der Dev-Proxy des
# Frontends zeigt auf BACKEND_PORT. make e2e liest .env nicht.
# BACKEND_PORT=8080
# FRONTEND_PORT=4200
